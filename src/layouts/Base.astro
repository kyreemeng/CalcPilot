---
import '../styles/global.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteUrl, brand } from '../data/site';
import { organizationJsonLd, websiteJsonLd, webPageJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Override the canonical/OG path, or pass null for non-canonical error pages. */
  canonicalPath?: string | null;
}

const { title, description = '', jsonLd, noindex = false, canonicalPath } = Astro.props;
const canonical = canonicalPath === null ? null : new URL(canonicalPath ?? Astro.url.pathname, siteUrl).href;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();

// Always emit Organization + WebSite, then merge any page-specific schema.
const pageGraph = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const graph = [
  organizationJsonLd(),
  websiteJsonLd(),
  ...(canonical ? [webPageJsonLd(canonical, title, description)] : []),
  ...pageGraph,
];
const safeJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand} — free online calculators`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content={`${brand} — free online calculators`} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}

    {safeJsonLd && <script is:inline type="application/ld+json" set:html={safeJsonLd} />}
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="+qDbq52jCunsUoGmwBDo1Q" async></script>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('calcpilot-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <noscript>
      <style>
        .reveal, .reveal-stagger > * { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <script>
      // --- Theme toggle ---
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-toggle');
      function currentTheme(): 'light' | 'dark' {
        const attr = root.getAttribute('data-theme');
        if (attr === 'light' || attr === 'dark') return attr;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function setTheme(next: 'light' | 'dark') {
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('calcpilot-theme', next); } catch (e) {}
        if (themeBtn) {
          themeBtn.setAttribute('aria-label', next === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
      }
      themeBtn?.addEventListener('click', () => {
        setTheme(currentTheme() === 'dark' ? 'light' : 'dark');
      });
      if (themeBtn) {
        themeBtn.setAttribute('aria-label', currentTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      }

      // --- Scroll reveal via IntersectionObserver ---
      const revealEls = document.querySelectorAll('.reveal, .reveal-stagger');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // --- Sticky header shadow on scroll ---
      const header = document.querySelector('.site-header');
      if (header) {
        const onScroll = () => {
          if (window.scrollY > 8) header.classList.add('scrolled');
          else header.classList.remove('scrolled');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
