---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | CalcPilot" description="The page you are looking for could not be found." noindex>
  <div class="container">
    <div class="title-block">
      <h1>Page not found</h1>
      <p class="lead">Sorry, we couldn't find that page. It may have moved or no longer exists.</p>
    </div>
    <section class="section section--tight">
      <a class="btn btn-primary" href="/">Back to home</a>
    </section>
  </div>
</Base>
