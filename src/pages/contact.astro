---
import Base from '../layouts/Base.astro';
import TrustLayout from '../components/TrustLayout.astro';
import { repositoryUrl } from '../data/site';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Contact' }];
---

<Base
  title="Contact CalcPilot — Report an Error or Send Feedback"
  description="Report an incorrect result, suggest a calculator, or ask a question by opening an issue in the CalcPilot public GitHub repository."
>
  <TrustLayout
    title="Contact Us"
    lead="Questions, feedback, or a correction to report? We would love to hear from you."
    crumbs={crumbs}
  >
    <div class="contact-card">
      <h2>Contact and corrections</h2>
      <p>
        CalcPilot is an open-source project. To report an incorrect result, suggest a calculator, or ask a question,
        open an issue in our public repository.
      </p>
      <p>
        <a class="btn btn-primary" href={`${repositoryUrl}/issues/new`} rel="external">Open a GitHub issue</a>
      </p>
      <p>Please do not include sensitive financial, health, or personal information in a public issue.</p>
      <h2>What we fix first</h2>
      <p>
        Wrong numbers come before everything else. If a calculator shows an incorrect result, include the inputs you
        used and the result you expected — we verify each report against the reference formula on the
        <a href="/methodology">methodology page</a> and patch the calculation before touching anything else.
      </p>
      <p>
        Suggestions for new calculators are triaged by search demand and fit: a good request names the calculation,
        who needs it, and an example input. Unit conversions and everyday math that match the existing categories
        (finance, converters, time and date, everyday) ship fastest.
      </p>
      <p>
        General questions — how a formula works, why a result differs from another site, which converter to use —
        are answered in each tool's FAQ section, so check the calculator page first for the fastest answer.
      </p>
    </div>
  </TrustLayout>
</Base>
