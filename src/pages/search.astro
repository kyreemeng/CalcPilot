---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { allTools, toolIcon, brand } from '../data/site';
import { iconSvg } from '../lib/icons';

const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const term = query.toLowerCase();

const tools = allTools.map((t) => ({
  href: t.href,
  title: t.title,
  shortDesc: t.shortDesc,
  verb: t.category === 'converters' ? 'Open converter' : 'Open calculator',
  icon: iconSvg(toolIcon(t.slug), 22),
}));

const matches = term
  ? tools.filter((t) => `${t.title} ${t.shortDesc} ${t.verb}`.toLowerCase().includes(term))
  : tools;

const toolsJson = JSON.stringify(tools).replace(/</g, '\\u003c');
---

<Base title={`Search | ${brand}`} description="Search CalcPilot calculators and converters." noindex>
  <div class="container">
    <div class="title-block">
      <h1>Search</h1>
      <p class="lead">Find the calculator or converter you need.</p>
    </div>

    <form class="hero-search-row" id="search-form" action="/search" method="get" role="search">
      <label class="hero-search">
        <Icon name="search" size={18} />
        <input
          type="search"
          id="search-input"
          name="q"
          value={query}
          placeholder="Try 'mortgage' or 'kg to lbs'"
          aria-label="Search"
        />
      </label>
      <button class="btn btn-primary" type="submit">Search</button>
    </form>

    <section class="section section--tight reveal">
      <div class="card-grid" id="results">
        {
          matches.map((t) => (
            <a class="tool-card" href={t.href}>
              <span class="tool-icon" set:html={t.icon} />
              <h3>{t.title}</h3>
              <p>{t.shortDesc}</p>
              <span class="link-arrow">{t.verb} →</span>
            </a>
          ))
        }
      </div>
      <p class="search-empty" id="empty" hidden={matches.length > 0}>No tools found. Try a different search.</p>
    </section>
  </div>
</Base>

<script is:inline type="application/json" id="tools-data" set:html={toolsJson}></script>

<script>
  interface Tool {
    href: string;
    title: string;
    shortDesc: string;
    verb: string;
    icon: string;
  }
  const tools = JSON.parse(document.getElementById('tools-data')!.textContent!) as Tool[];
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('results')!;
  const empty = document.getElementById('empty')!;
  const form = document.getElementById('search-form')!;

  function render(query: string) {
    const term = query.trim().toLowerCase();
    const matches = term
      ? tools.filter((t) => `${t.title} ${t.shortDesc} ${t.verb}`.toLowerCase().includes(term))
      : tools;
    empty.hidden = matches.length > 0;
    results.innerHTML = matches
      .map(
        (t, i) => `
        <a class="tool-card" href="${t.href}" style="animation: fade-up 0.35s var(--ease-out) ${Math.min(i * 0.04, 0.3)}s both;">
          <span class="tool-icon">${t.icon}</span>
          <h3>${t.title}</h3>
          <p>${t.shortDesc}</p>
          <span class="link-arrow">${t.verb} →</span>
        </a>`
      )
      .join('');
  }

  input.addEventListener('input', () => render(input.value));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const next = new URL(location.href);
    const q = input.value.trim();
    if (q) next.searchParams.set('q', q);
    else next.searchParams.delete('q');
    history.replaceState(null, '', next);
    render(input.value);
  });
</script>
