---
import Base from '../layouts/Base.astro';
import TrustLayout from '../components/TrustLayout.astro';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Disclaimer' }];
---

<Base
  title="Disclaimer | CalcPilot"
  description="Please read this important notice before using CalcPilot's calculators and converters. Results are estimates for planning purposes only."
>
  <TrustLayout
    title="Disclaimer"
    lead="Please read this important notice before using CalcPilot's calculators and converters."
    crumbs={crumbs}
  >
    <p>
      CalcPilot provides free online calculators and unit converters for general information and planning purposes
      only. Every result is generated by formulas and standard conversion factors; we strive for accuracy but do not
      warrant that outputs are error-free or suitable for any specific purpose.
    </p>
    <p>
      <strong>No financial, legal, tax or professional advice.</strong> Our finance tools estimate payments, balances
      and growth — they are not a substitute for advice from a qualified mortgage broker, lender, accountant, lawyer
      or other professional. Always confirm figures with the relevant institution before making decisions.
    </p>
    <p>
      <strong>Rates and rules change.</strong> Interest rates, tax rates, fees and unit definitions vary by location
      and over time. CalcPilot is not responsible for losses or actions taken on the basis of its estimates.
    </p>
    <p>
      <strong>Third-party content.</strong> This site may link to external websites, which are solely responsible for
      their own content and governed by their own terms.
    </p>
    <p>
      <strong>Corrections.</strong> If you find an incorrect formula, conversion factor, or result, please report it
      through our <a href="/contact">Contact</a> page so it can be reviewed.
    </p>
  </TrustLayout>
</Base>
