---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Tip Calculator';
const desc =
  'Calculate tip amount, total bill, and per-person split from any tip percentage. Instant results for restaurants and shared checks.';
const path = '/everyday/tip-calculator';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Everyday', href: '/everyday' },
  { label: title },
];
const howTo = {
  steps: [
    'Enter the pre-tip bill amount.',
    'Choose a tip percentage and how many people are splitting the check.',
    'Read the tip amount, full total, and the amount each person owes.',
  ],
};
const understanding = {
  desc: 'Tip amount = bill × tip% ÷ 100. Total bill = bill + tip. Per person = total ÷ number of people. If you only need the percentage amount without a bill split, use the <a href="/everyday/percentage-calculator">Percentage Calculator</a>. Common restaurant tips range from about 15% to 20%, but customs vary by place and service type.',
};
const faqs = [
  {
    q: 'Should I tip on tax?',
    a: 'Local customs differ. Many people tip on the pre-tax subtotal; others tip on the full receipt. Enter whichever base you prefer.',
  },
  {
    q: 'How do I split a tip evenly?',
    a: 'Set “Split between” to the number of people. The calculator divides the tipped total evenly across that count.',
  },
  {
    q: 'Can I use a custom tip percentage?',
    a: 'Yes. Enter any percentage, including decimals, and the tip, total, and split update immediately.',
  },
];
const related = ['percentage-calculator', 'discount-calculator', 'bmi-calculator'];
---

<Base
  title={`${title} — Tip Amount & Total Bill | CalcPilot`}
  description={desc}
  jsonLd={simpleJsonLd(title, path, 'UtilitiesApplication', desc, { howToSteps: howTo.steps, faqs })}
>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Enter the bill, choose a tip percentage, and split the tipped total across people — updated as you type."
    howTo={howTo}
    understanding={understanding}
    faqs={faqs}
    related={related}
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="bill">Bill amount</label>
        <div class="input-wrap"><span class="prefix">$</span><input id="bill" type="number" inputmode="decimal" min="0" step="0.01" value="50" /></div>
      </div>
      <div class="field">
        <label for="tip">Tip percentage</label>
        <div class="input-wrap"><input id="tip" type="number" inputmode="decimal" min="0" step="1" value="18" /><span class="suffix">%</span></div>
      </div>
      <div class="field">
        <label for="split">Split between</label>
        <div class="input-wrap"><input id="split" type="number" inputmode="numeric" min="1" step="1" value="2" /><span class="suffix">people</span></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Tip amount</p>
      <div class="result-amount" id="tip-val">$9.00</div>
      <div class="result-subtitle" id="sub">18% tip on $50.00</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail">
        <div class="breakdown-row"><span class="blabel">Total bill</span><span class="bvalue">$59.00</span></div>
        <div class="breakdown-row"><span class="blabel">Per person</span><span class="bvalue">$29.50</span></div>
      </div>
    </div>
  </SimpleTool>
</Base>

<script>
  const billEl = document.getElementById('bill') as HTMLInputElement;
  const tipEl = document.getElementById('tip') as HTMLInputElement;
  const splitEl = document.getElementById('split') as HTMLInputElement;
  const tipVal = document.getElementById('tip-val')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;

  const usd = (n: number) => `$${n.toFixed(2)}`;

  function calc() {
    const bill = parseFloat(billEl.value) || 0;
    const tipPct = parseFloat(tipEl.value) || 0;
    const split = Math.max(1, parseInt(splitEl.value, 10) || 1);

    const tip = (bill * tipPct) / 100;
    const total = bill + tip;

    tipVal.textContent = usd(tip);
    subEl.textContent = `${tipPct}% tip on ${usd(bill)}`;
    detailEl.innerHTML = `
      <div class="breakdown-row"><span class="blabel">Total bill</span><span class="bvalue">${usd(total)}</span></div>
      <div class="breakdown-row"><span class="blabel">Per person</span><span class="bvalue">${usd(total / split)}</span></div>
    `;
  }

  billEl.addEventListener('input', calc);
  tipEl.addEventListener('input', calc);
  splitEl.addEventListener('input', calc);
  calc();
</script>
