---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Tip Calculator';
const desc = 'Calculate the tip amount, total bill and split per person.';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Everyday', href: '/everyday' },
  { label: title },
];
---

<Base title={`${title} — Tip Amount & Total Bill | CalcPilot`} description={desc} jsonLd={simpleJsonLd(title, '/everyday/tip-calculator', 'UtilitiesApplication', desc)}>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Enter the bill, choose a tip percentage, and split the total across people."
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="bill">Bill amount</label>
        <div class="input-wrap"><span class="prefix">$</span><input id="bill" type="number" inputmode="decimal" min="0" step="0.01" value="50" /></div>
      </div>
      <div class="field">
        <label for="tip">Tip percentage</label>
        <div class="input-wrap"><input id="tip" type="number" inputmode="decimal" min="0" step="1" value="18" /><span class="suffix">%</span></div>
      </div>
      <div class="field">
        <label for="split">Split between</label>
        <div class="input-wrap"><input id="split" type="number" inputmode="numeric" min="1" step="1" value="2" /><span class="suffix">people</span></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Tip amount</p>
      <div class="result-amount" id="tip-val">--</div>
      <div class="result-subtitle" id="sub">—</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail"></div>
    </div>
  </SimpleTool>
</Base>

<script>
  const billEl = document.getElementById('bill') as HTMLInputElement;
  const tipEl = document.getElementById('tip') as HTMLInputElement;
  const splitEl = document.getElementById('split') as HTMLInputElement;
  const tipVal = document.getElementById('tip-val')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;

  const usd = (n: number) => `$${n.toFixed(2)}`;

  function calc() {
    const bill = parseFloat(billEl.value) || 0;
    const tipPct = parseFloat(tipEl.value) || 0;
    const split = Math.max(1, parseInt(splitEl.value, 10) || 1);

    const tip = (bill * tipPct) / 100;
    const total = bill + tip;

    tipVal.textContent = usd(tip);
    subEl.textContent = `${tipPct}% tip on ${usd(bill)}`;
    detailEl.innerHTML = `
      <div class="breakdown-row"><span class="blabel">Total bill</span><span class="bvalue">${usd(total)}</span></div>
      <div class="breakdown-row"><span class="blabel">Per person</span><span class="bvalue">${usd(total / split)}</span></div>
    `;
  }

  billEl.addEventListener('input', calc);
  tipEl.addEventListener('input', calc);
  splitEl.addEventListener('input', calc);
  calc();
</script>
