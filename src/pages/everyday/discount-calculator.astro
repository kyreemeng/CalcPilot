---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Discount Calculator';
const desc = 'Find the final price and savings after a percentage discount.';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Everyday', href: '/everyday' },
  { label: title },
];
---

<Base title={`${title} — Final Price After Discount | CalcPilot`} description={desc} jsonLd={simpleJsonLd(title, '/everyday/discount-calculator', 'UtilitiesApplication', desc)}>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Enter the original price and a discount percentage to see the final price."
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="price">Original price</label>
        <div class="input-wrap"><span class="prefix">$</span><input id="price" type="number" inputmode="decimal" min="0" step="0.01" value="80" /></div>
      </div>
      <div class="field">
        <label for="discount">Discount</label>
        <div class="input-wrap"><input id="discount" type="number" inputmode="decimal" min="0" max="100" step="1" value="25" /><span class="suffix">%</span></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Final price</p>
      <div class="result-amount" id="final">--</div>
      <div class="result-subtitle" id="sub">—</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail"></div>
    </div>
  </SimpleTool>
</Base>

<script>
  const priceEl = document.getElementById('price') as HTMLInputElement;
  const discountEl = document.getElementById('discount') as HTMLInputElement;
  const finalEl = document.getElementById('final')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;

  const usd = (n: number) => `$${n.toFixed(2)}`;

  function calc() {
    const price = parseFloat(priceEl.value) || 0;
    const pct = parseFloat(discountEl.value) || 0;
    const off = (price * pct) / 100;
    const final = price - off;

    finalEl.textContent = usd(final);
    subEl.textContent = `after ${pct}% off`;
    detailEl.innerHTML = `
      <div class="breakdown-row"><span class="blabel">You save</span><span class="bvalue">${usd(off)}</span></div>
      <div class="breakdown-row"><span class="blabel">Original price</span><span class="bvalue">${usd(price)}</span></div>
    `;
  }

  priceEl.addEventListener('input', calc);
  discountEl.addEventListener('input', calc);
  calc();
</script>
