---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Percentage Calculator';
// "PCT calculator" is the abbreviated query GSC shows impressions for; the
// plain-language "percent calculator" variant rides along in the description.
const desc =
  'Free percentage calculator (PCT calculator): what is X% of Y, and what percent is X of Y — plus percentage increase, decrease, change and difference formulas. No sign-up.';
const path = '/everyday/percentage-calculator';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Everyday', href: '/everyday' },
  { label: title },
];
const howTo = {
  steps: [
    'Pick a mode: “What is X% of Y?” or “X is what percent of Y?”.',
    'Enter the two numbers — for example 15 and 200.',
    'Read the result and the breakdown showing the exact calculation used.',
  ],
};
const understanding = {
  desc: 'A percentage is a fraction of 100. To find <strong>X% of Y</strong>, multiply Y by X and divide by 100: <strong>result = Y × (X ÷ 100)</strong> — so 15% of 200 is 200 × 0.15 = 30. The reverse question, <strong>“what percent is X of Y?”</strong>, divides instead: X ÷ Y × 100, so 30 is 15% of 200. For bill totals and splits, use the <a href="/everyday/tip-calculator">Tip Calculator</a>; for sale prices and savings, use the <a href="/everyday/discount-calculator">Discount Calculator</a>.',
};
const changeSection = {
  title: 'Percentage increase, decrease and change',
  html: `<p class="understanding-desc">When a value moves from one number to another, the <strong>percentage change</strong> is (new − old) ÷ old × 100. A rise gives a positive percentage increase (80 → 100 is +25%) and a fall gives a negative percentage decrease (100 → 80 is −20%). The old value always divides the difference, which is why a 25% increase followed by a 25% decrease does not return to the start.</p>
<div class="formula-panel">
  <p class="formula-primary">% change = (new − old) ÷ old × 100</p>
  <p class="formula-secondary">Increase and decrease use the same formula — only the sign differs</p>
</div>
<p class="understanding-desc">Enter both values and let the <a href="/everyday/percentage-change-calculator">Percentage Change Calculator</a> do this directly, including the absolute difference between the two numbers. It applies the same formula this page states, so both tools always agree.</p>`,
};
const faqs = [
  {
    q: 'What is the formula for a percentage of a number?',
    a: 'Multiply the number by the percentage, then divide by 100. Example: 15% of 200 = 200 × 0.15 = 30.',
  },
  {
    q: 'What percent is X of Y?',
    a: 'Divide X by Y and multiply by 100. Example: 30 is what percent of 200? 30 ÷ 200 × 100 = 15%. The second mode of this calculator does it instantly.',
  },
  {
    q: 'Can I use decimals like 12.5%?',
    a: 'Yes. Enter any decimal percentage and the result updates immediately.',
  },
  {
    q: 'Is a pct calculator the same as a percentage calculator?',
    a: 'Yes. “PCT” is just the abbreviation for percent, so a pct calculator and a percentage calculator are the same tool — this page answers both phrasings.',
  },
  {
    q: 'How do I calculate percentage increase or decrease?',
    a: 'Use % change = (new − old) ÷ old × 100. A positive result is an increase, a negative one a decrease. The Percentage Change Calculator applies this formula for you.',
  },
  {
    q: 'How is this different from a tip or discount calculator?',
    a: 'This tool solves the plain math questions “what is X% of Y?” and “what percent is X of Y?” Tip and discount calculators add bill totals, split shares, and savings context on top of that formula.',
  },
];
const related = ['percentage-change-calculator', 'tip-calculator', 'discount-calculator'];
---

<Base
  title={`${title} — Free PCT Calculator | CalcPilot`}
  description={desc}
  jsonLd={simpleJsonLd(title, path, 'UtilitiesApplication', desc, { howToSteps: howTo.steps, faqs })}
>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="A free PCT calculator for the two everyday percent questions — X% of a number, and one number as a percent of another — with tips, discounts and fees one click away."
    howTo={howTo}
    understanding={understanding}
    sections={[changeSection]}
    faqs={faqs}
    related={related}
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="mode-switch" role="group" aria-label="Calculation mode">
        <button type="button" class="mode-btn is-active" data-mode="of" aria-pressed="true">What is X% of Y?</button>
        <button type="button" class="mode-btn" data-mode="ratio" aria-pressed="false">X is what percent of Y?</button>
      </div>
      <div class="field">
        <label for="value" id="label-value">Number</label>
        <div class="input-wrap"><input id="value" type="number" inputmode="decimal" step="any" value="200" /></div>
      </div>
      <div class="field">
        <label for="pct" id="label-pct">Percentage</label>
        <div class="input-wrap"><input id="pct" type="number" inputmode="decimal" step="any" value="15" /><span class="suffix" id="suffix-pct">%</span></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Result</p>
      <div class="result-amount" id="res">30</div>
      <div class="result-subtitle" id="sub">15% of 200</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail">
        <div class="breakdown-row"><span class="blabel">200 × 15% =</span><span class="bvalue">30</span></div>
      </div>
    </div>
  </SimpleTool>
</Base>

<script>
  const valueEl = document.getElementById('value') as HTMLInputElement;
  const pctEl = document.getElementById('pct') as HTMLInputElement;
  const resEl = document.getElementById('res')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;
  const labelValue = document.getElementById('label-value')!;
  const labelPct = document.getElementById('label-pct')!;
  const suffixPct = document.getElementById('suffix-pct')!;
  const modeBtns = Array.from(document.querySelectorAll('.mode-btn')) as HTMLButtonElement[];

  const fmtNum = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 4 });

  // "of" answers "what is X% of Y?"; "ratio" answers the reverse, "what
  // percent is X of Y?". Both reuse the same two inputs.
  let mode = 'of';

  function calc() {
    const a = parseFloat(valueEl.value);
    const b = parseFloat(pctEl.value);
    if (!Number.isFinite(a) || !Number.isFinite(b)) return;

    if (mode === 'of') {
      const result = (a * b) / 100;
      resEl.textContent = fmtNum(result);
      subEl.textContent = `${fmtNum(b)}% of ${a.toLocaleString('en-US')}`;
      // The "=" keeps the extracted text readable ("200 × 15% = 30") —
      // without it the label and value concatenate into "200 × 15%30".
      detailEl.innerHTML = `
        <div class="breakdown-row"><span class="blabel">${a.toLocaleString('en-US')} × ${fmtNum(b)}% =</span><span class="bvalue">${fmtNum(result)}</span></div>
      `;
    } else {
      if (b === 0) return;
      const result = (a / b) * 100;
      resEl.textContent = `${fmtNum(result)}%`;
      subEl.textContent = `${a.toLocaleString('en-US')} is ${fmtNum(result)}% of ${b.toLocaleString('en-US')}`;
      detailEl.innerHTML = `
        <div class="breakdown-row"><span class="blabel">${a.toLocaleString('en-US')} ÷ ${b.toLocaleString('en-US')} × 100 =</span><span class="bvalue">${fmtNum(result)}%</span></div>
      `;
    }
  }

  function setMode(next: string) {
    mode = next;
    for (const btn of modeBtns) {
      const active = btn.dataset.mode === next;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    }
    if (next === 'of') {
      labelValue.textContent = 'Number';
      labelPct.textContent = 'Percentage';
      suffixPct.style.display = '';
    } else {
      labelValue.textContent = 'Part (X)';
      labelPct.textContent = 'Whole (Y)';
      suffixPct.style.display = 'none';
    }
    calc();
  }

  for (const btn of modeBtns) btn.addEventListener('click', () => setMode(btn.dataset.mode!));
  valueEl.addEventListener('input', calc);
  pctEl.addEventListener('input', calc);
  calc();
</script>
