---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Percentage Calculator';
const desc =
  'Find what percent of any number is instantly. Use X% of Y for discounts, tips, tax estimates, and everyday percentage math.';
const path = '/everyday/percentage-calculator';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Everyday', href: '/everyday' },
  { label: title },
];
const howTo = {
  steps: [
    'Enter the base number you want to take a percentage of.',
    'Enter the percentage value (for example 15 for 15%).',
    'Read the result and the breakdown showing the exact multiplication used.',
  ],
};
const understanding = {
  desc: 'A percentage is a fraction of 100. To find X% of Y, multiply Y by X and divide by 100: result = Y × (X ÷ 100). For bill totals and splits, use the <a href="/everyday/tip-calculator">Tip Calculator</a>; for sale prices and savings, use the <a href="/everyday/discount-calculator">Discount Calculator</a>.',
};
const faqs = [
  {
    q: 'What is the formula for a percentage of a number?',
    a: 'Multiply the number by the percentage, then divide by 100. Example: 15% of 200 = 200 × 0.15 = 30.',
  },
  {
    q: 'Can I use decimals like 12.5%?',
    a: 'Yes. Enter any decimal percentage and the result updates immediately.',
  },
  {
    q: 'How is this different from a tip or discount calculator?',
    a: 'This tool solves the plain math question “what is X% of Y?” Tip and discount calculators add bill totals, split shares, and savings context on top of that formula.',
  },
];
const related = ['tip-calculator', 'loan-calculator', 'savings-calculator'];
---

<Base
  title={`${title} — What is X% of Y | CalcPilot`}
  description={desc}
  jsonLd={simpleJsonLd(title, path, 'UtilitiesApplication', desc, { howToSteps: howTo.steps, faqs })}
>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Enter a number and a percentage to see X% of Y instantly — useful for tips, discounts, fees, and quick checks."
    howTo={howTo}
    understanding={understanding}
    faqs={faqs}
    related={related}
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="value">Number</label>
        <div class="input-wrap"><input id="value" type="number" inputmode="decimal" step="any" value="200" /></div>
      </div>
      <div class="field">
        <label for="pct">Percentage</label>
        <div class="input-wrap"><input id="pct" type="number" inputmode="decimal" step="any" value="15" /><span class="suffix">%</span></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Result</p>
      <div class="result-amount" id="res">30</div>
      <div class="result-subtitle" id="sub">15% of 200</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail">
        <div class="breakdown-row"><span class="blabel">200 × 15%</span><span class="bvalue">30</span></div>
      </div>
    </div>
  </SimpleTool>
</Base>

<script>
  const valueEl = document.getElementById('value') as HTMLInputElement;
  const pctEl = document.getElementById('pct') as HTMLInputElement;
  const resEl = document.getElementById('res')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;

  function calc() {
    const value = parseFloat(valueEl.value);
    const pct = parseFloat(pctEl.value);
    if (!Number.isFinite(value) || !Number.isFinite(pct)) return;
    const result = (value * pct) / 100;

    resEl.textContent = result.toLocaleString('en-US', { maximumFractionDigits: 4 });
    subEl.textContent = `${pct}% of ${value.toLocaleString('en-US')}`;
    detailEl.innerHTML = `
      <div class="breakdown-row"><span class="blabel">${value.toLocaleString('en-US')} × ${pct}%</span><span class="bvalue">${result.toLocaleString('en-US', { maximumFractionDigits: 4 })}</span></div>
    `;
  }

  valueEl.addEventListener('input', calc);
  pctEl.addEventListener('input', calc);
  calc();
</script>
