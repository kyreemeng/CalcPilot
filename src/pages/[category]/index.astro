---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import ToolCard from '../../components/ToolCard.astro';
import { hubs, categories, categoryIcons, getHub, toolIcon, brand } from '../../data/site';
import { itemListJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return hubs.map((h) => ({ params: { category: h.id } }));
}

const { category } = Astro.params;
const hub = getHub(category ?? '');
if (!hub) return Astro.redirect('/404');

const crumbs = [{ label: 'Home', href: '/' }, { label: hub.title }];
const verb = hub.id === 'converters' ? 'Open converter' : 'Open calculator';
const otherCategories = categories.filter((c) => c.id !== hub.id);
const itemList = itemListJsonLd(hub.toolRefs.map((tool) => ({ name: tool.title, path: tool.href })));
---

<Base title={`${hub.seoTitle} | ${brand}`} description={hub.seoDescription} jsonLd={itemList}>
  <div class="container">
    <Breadcrumb crumbs={crumbs} />
    <div class="title-block">
      <h1>{hub.seoTitle}</h1>
      <p class="hub-intro">{hub.intro}</p>
    </div>

    {
      hub.toolRefs.length > 0 ? (
        <section class="section section--tight reveal">
          <div class="card-grid reveal-stagger">
            {hub.toolRefs.map((t) => (
              <ToolCard href={t.href} title={t.title} shortDesc={t.shortDesc} icon={toolIcon(t.slug)} verb={verb} />
            ))}
          </div>
        </section>
      ) : (
        <section class="section section--tight reveal">
          <div class="planned-note">
            These tools are coming soon. In the meantime, explore our <a href="/finance">Finance</a> and{' '}
            <a href="/converters">Converters</a> categories.
          </div>
        </section>
      )
    }

    <section class="section reveal">
      <h2 class="section-title">More calculators</h2>
      <div class="card-grid reveal-stagger">
        {otherCategories.map((c) => (
          <CategoryCard name={c.name} href={c.href} blurb={c.blurb} icon={categoryIcons[c.id]} />
        ))}
      </div>
    </section>
  </div>
</Base>
