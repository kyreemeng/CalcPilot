---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Date Difference Calculator';
const desc =
  'Calculate exact days between two dates, plus weeks and approximate months. Useful for project timelines, billing periods and travel planning.';
const path = '/time-date/date-difference-calculator';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Time & Date', href: '/time-date' },
  { label: title },
];
const howTo = {
  steps: [
    'Choose a start date and an end date.',
    'Read the absolute day count between them.',
    'Use the weeks and approximate months for a quicker sense of span.',
  ],
};
const understanding = {
  desc: 'Day count is the number of midnights between the two calendar dates. Weeks are full 7-day blocks. Months are an approximation using 30.4375 days (the average Gregorian month), so they are useful for planning, not legal billing unless your contract says otherwise.',
};
const faqs = [
  {
    q: 'Are both dates inclusive?',
    a: 'This calculator reports the day difference between the two midnights. Crossing from Jan 1 to Jan 2 is 1 day.',
  },
  {
    q: 'What if the end date is earlier?',
    a: 'You still get a positive day count, with a note that the end date is before the start date.',
  },
  {
    q: 'Why are months approximate?',
    a: 'Months vary in length. The months figure uses an average-month conversion so you can estimate longer spans quickly.',
  },
];
const related = ['age-calculator', 'date-add-calculator', 'countdown-calculator'];
---

<Base
  title={`${title} — Days Between Dates | CalcPilot`}
  description={desc}
  jsonLd={simpleJsonLd(title, path, 'UtilitiesApplication', desc, { howToSteps: howTo.steps, faqs })}
>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Pick a start and end date to see exactly how many days, weeks and approximate months are between them."
    howTo={howTo}
    understanding={understanding}
    faqs={faqs}
    related={related}
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="start">Start date</label>
        <div class="input-wrap"><input id="start" type="date" value="2026-01-01" /></div>
      </div>
      <div class="field">
        <label for="end">End date</label>
        <div class="input-wrap"><input id="end" type="date" value="2026-12-31" /></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">Days between</p>
      <div class="result-amount" id="days">364</div>
      <div class="result-subtitle" id="sub">between the two dates</div>
      <hr class="result-divider" />
      <div class="breakdown" id="detail">
        <div class="breakdown-row"><span class="blabel">Weeks</span><span class="bvalue">52</span></div>
        <div class="breakdown-row"><span class="blabel">Months (approx.)</span><span class="bvalue">11</span></div>
      </div>
    </div>
  </SimpleTool>
</Base>

<script>
  const startEl = document.getElementById('start') as HTMLInputElement;
  const endEl = document.getElementById('end') as HTMLInputElement;
  const daysEl = document.getElementById('days')!;
  const subEl = document.getElementById('sub')!;
  const detailEl = document.getElementById('detail')!;

  function calc() {
    const start = new Date(startEl.value + 'T00:00:00');
    const end = new Date(endEl.value + 'T00:00:00');
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return;

    const diff = Math.round((end.getTime() - start.getTime()) / 86400000);
    const abs = Math.abs(diff);
    const weeks = Math.floor(abs / 7);
    const months = Math.floor(abs / 30.4375);

    daysEl.textContent = abs.toLocaleString('en-US');
    subEl.textContent = diff < 0 ? 'end date is before start date' : 'between the two dates';
    detailEl.innerHTML = `
      <div class="breakdown-row"><span class="blabel">Weeks</span><span class="bvalue">${weeks.toLocaleString('en-US')}</span></div>
      <div class="breakdown-row"><span class="blabel">Months (approx.)</span><span class="bvalue">${months.toLocaleString('en-US')}</span></div>
    `;
  }

  startEl.addEventListener('change', calc);
  endEl.addEventListener('change', calc);
  calc();
</script>
