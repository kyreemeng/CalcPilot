---
import Base from '../../layouts/Base.astro';
import SimpleTool from '../../components/SimpleTool.astro';
import { simpleJsonLd } from '../../lib/seo';

const title = 'Date Add Calculator';
const desc =
  'Add or subtract any number of days from a start date to find the resulting calendar date. Ideal for deadlines and due dates.';
const path = '/time-date/date-add-calculator';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Time & Date', href: '/time-date' },
  { label: title },
];
const howTo = {
  steps: [
    'Choose a start date.',
    'Select whether to add or subtract days, then enter the day count.',
    'Read the resulting calendar date instantly.',
  ],
};
const understanding = {
  desc: 'The calculator shifts the start date by a whole number of midnights. Adding 90 days to January 1 lands on April 1 in a non-leap-year path from that origin; leap days are included automatically by the browser calendar. Once you have a deadline, the <a href="/time-date/countdown-calculator">Countdown Calculator</a> can show how long remains.',
};
const faqs = [
  {
    q: 'Does this account for leap years?',
    a: 'Yes. The result uses the local calendar, so February 29 is included when it exists between the start and end.',
  },
  {
    q: 'Can I add weeks or months instead of days?',
    a: 'Convert weeks to days (×7) first. For month arithmetic with variable lengths, verify the final date carefully or use a dedicated month offset later.',
  },
  {
    q: 'Is the start date counted as day zero?',
    a: 'Yes. Adding 0 days returns the same date; adding 1 day returns the next calendar day.',
  },
];
const related = ['date-difference-calculator', 'countdown-calculator', 'age-calculator'];
---

<Base
  title={`${title} — Add or Subtract Days | CalcPilot`}
  description={desc}
  jsonLd={simpleJsonLd(title, path, 'UtilitiesApplication', desc, { howToSteps: howTo.steps, faqs })}
>
  <SimpleTool
    crumbs={crumbs}
    title={title}
    lead="Start from a date, choose add or subtract, and enter how many days to move to find the new date."
    howTo={howTo}
    understanding={understanding}
    faqs={faqs}
    related={related}
  >
    <div slot="form">
      <h2 class="form-title">Your details</h2>
      <div class="field">
        <label for="start">Start date</label>
        <div class="input-wrap"><input id="start" type="date" value="2026-01-01" /></div>
      </div>
      <div class="field">
        <label for="op">Operation</label>
        <div class="input-wrap">
          <select id="op">
            <option value="add">Add days</option>
            <option value="subtract">Subtract days</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="days">Number of days</label>
        <div class="input-wrap"><input id="days" type="number" inputmode="numeric" min="0" step="1" value="90" /></div>
      </div>
    </div>

    <div slot="result">
      <p class="result-label">New date</p>
      <div class="result-amount" id="new-date">Apr 1, 2026</div>
      <div class="result-subtitle" id="sub">plus 90 days</div>
    </div>
  </SimpleTool>
</Base>

<script>
  const startEl = document.getElementById('start') as HTMLInputElement;
  const opEl = document.getElementById('op') as HTMLSelectElement;
  const daysEl = document.getElementById('days') as HTMLInputElement;
  const outEl = document.getElementById('new-date')!;
  const subEl = document.getElementById('sub')!;

  function calc() {
    const start = new Date(startEl.value + 'T00:00:00');
    const n = parseInt(daysEl.value, 10);
    if (isNaN(start.getTime()) || !Number.isFinite(n)) return;

    const delta = opEl.value === 'subtract' ? -n : n;
    const result = new Date(start.getTime() + delta * 86400000);

    outEl.textContent = result.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    subEl.textContent = `${opEl.value === 'subtract' ? 'minus' : 'plus'} ${n} day${n === 1 ? '' : 's'}`;
  }

  startEl.addEventListener('change', calc);
  opEl.addEventListener('change', calc);
  daysEl.addEventListener('input', calc);
  calc();
</script>
