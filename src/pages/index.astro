---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { brand, categories, categoryIcons, getToolRef, toolIcon, popularSlugs } from '../data/site';
---

<Base
  title={`Free Online Calculators & Converters | ${brand}`}
  description="Free kg to lbs converter, USD salary calculator (hourly to monthly after tax), mortgage tools and more. No sign-up — instant private results."
>
  <div class="container">
    <section class="hero">
      <span class="hero-eyebrow">Free online calculators</span>
      <h1>Free calculators: kg to lbs, salary, mortgage & more.</h1>
      <p class="hero-sub">
        Convert kg to lb, estimate USD monthly take-home from hourly pay, run mortgage and auto loan math,
        and more — no sign-up, no downloads, instant answers.
      </p>
      <form class="hero-search-row" action="/search" method="get" role="search">
        <label class="hero-search">
          <Icon name="search" size={18} />
          <input type="search" name="q" placeholder="Try 'kg to lbs' or 'salary calculator'" aria-label="Search calculators" />
        </label>
        <button class="btn btn-primary" type="submit">Calculate</button>
      </form>
      <div class="trust-badges">
        <span class="badge"><Icon name="check" size={18} /> No sign-up required</span>
        <span class="badge"><Icon name="check" size={18} /> Instant results (&lt;200ms)</span>
        <span class="badge"><Icon name="check" size={18} /> Mobile friendly</span>
      </div>
    </section>

    <section class="section reveal">
      <h2 class="section-title">Categories</h2>
      <div class="grid-4 reveal-stagger">
        {categories.map((c) => (
          <CategoryCard name={c.name} href={c.href} blurb={c.blurb} icon={categoryIcons[c.id]} />
        ))}
      </div>
    </section>

    <section class="section reveal">
      <h2 class="section-title">Popular calculators</h2>
      <div class="card-grid reveal-stagger">
        {popularSlugs.map((slug) => {
          const t = getToolRef(slug);
          if (!t) return null;
          return (
            <ToolCard
              href={t.href}
              title={t.title}
              shortDesc={t.shortDesc}
              icon={toolIcon(t.slug)}
              verb={t.category === 'converters' ? 'Open converter' : 'Open calculator'}
            />
          );
        })}
      </div>
    </section>
  </div>
</Base>
