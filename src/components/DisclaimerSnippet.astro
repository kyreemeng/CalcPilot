---
import Icon from './Icon.astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
const updated = new Date().toISOString().slice(0, 10);
const updatedLabel = new Date(updated + 'T00:00:00Z').toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<section class="section section--tight">
  <div class="disclaimer">
    <span class="disc-icon" aria-hidden="true"><Icon name="info" size={18} /></span>
    <div>
      <p class="disc-title">Disclaimer</p>
      <p>
        {text} Review our <a href="/methodology">calculation methodology</a> and full <a href="/disclaimer">disclaimer</a>.
      </p>
      <p>
        Content updated <time datetime={updated}>{updatedLabel}</time>.
      </p>
    </div>
  </div>
</section>
