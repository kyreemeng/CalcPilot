---
import { breadcrumbJsonLd } from '../lib/seo';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;

// Build BreadcrumbList schema (last item points at the current page URL).
const items = crumbs.map((c, i) => ({
  name: c.label,
  path: i === crumbs.length - 1 ? Astro.url.pathname : (c.href ?? ''),
}));
const safeJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  ...breadcrumbJsonLd(items),
}).replace(/</g, '\\u003c');
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  {
    crumbs.map((c, i) => {
      const isLast = i === crumbs.length - 1;
      return (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">›</span>}
          {isLast || !c.href ? (
            <span class="current" aria-current="page">{c.label}</span>
          ) : (
            <a href={c.href}>{c.label}</a>
          )}
        </>
      );
    })
  }
</nav>

<script is:inline type="application/ld+json" set:html={safeJsonLd}></script>
