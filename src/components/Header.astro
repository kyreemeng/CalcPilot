---
import Icon from './Icon.astro';
import { brand, nav } from '../data/site';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${brand} home`}>
      <img class="brand-img" src="/logo-icon.svg" alt="" width="32" height="32" />
      <span class="brand-name">{brand}</span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <div class="header-search">
        <form action="/search" method="get" role="search">
          <label class="search-box">
            <Icon name="search" size={16} />
            <input type="search" name="q" placeholder="Search calculators…" aria-label="Search calculators" />
          </label>
        </form>
      </div>

      <button
        type="button"
        class="icon-btn theme-toggle"
        id="theme-toggle"
        aria-label="Toggle color theme"
      >
        <span class="icon-sun" aria-hidden="true"><Icon name="sun" size={18} /></span>
        <span class="icon-moon" aria-hidden="true"><Icon name="moon" size={18} /></span>
      </button>

      <button
        class="icon-btn menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="menu-icon-open" aria-hidden="true"><Icon name="menu" size={20} /></span>
        <span class="menu-icon-close" aria-hidden="true" hidden><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const navEl = document.getElementById('main-nav');
  const openIcon = toggle?.querySelector('.menu-icon-open') as HTMLElement | null;
  const closeIcon = toggle?.querySelector('.menu-icon-close') as HTMLElement | null;

  function setMenu(open: boolean) {
    navEl?.classList.toggle('open', open);
    document.body.classList.toggle('nav-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (openIcon) openIcon.hidden = open;
    if (closeIcon) closeIcon.hidden = !open;
  }

  toggle?.addEventListener('click', () => {
    const open = !(navEl?.classList.contains('open') ?? false);
    setMenu(open);
  });

  navEl?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
