---
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  shortDesc: string;
  icon: string;
  verb?: string;
}

const { href, title, shortDesc, icon, verb = 'Open calculator' } = Astro.props;
---

<a class="tool-card" href={href}>
  <span class="tool-icon"><Icon name={icon} size={22} /></span>
  <h3>{title}</h3>
  <p>{shortDesc}</p>
  <span class="link-arrow">{verb} <Icon name="arrow-right" size={16} /></span>
</a>
