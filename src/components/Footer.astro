---
import Icon from './Icon.astro';
import { brand, footerColumns } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a class="footer-logo" href="/" aria-label="CalcPilot home">
          <img class="footer-img" src="/logo-icon.svg" alt="CalcPilot" width="32" height="32" />
          <span class="footer-name">{brand}</span>
        </a>
        <p class="footer-tagline">
          Free, private calculators for money, units, dates, and everyday math. Results update in your browser.
        </p>
        <div class="footer-trust">
          <span><Icon name="shield" size={14} /> Private by design</span>
          <span><Icon name="zap" size={14} /> Instant results</span>
          <span><Icon name="check" size={14} /> Transparent formulas</span>
        </div>
      </div>

      <div class="footer-cols">
        {
          footerColumns.map((col) => (
            <div class="footer-col">
              <h2 class="footer-col-title">{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li><a href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 {brand}. All rights reserved.</p>
      <p>
        <a href="/methodology">Methodology</a>
        {' · '}
        <a href="/privacy">Privacy</a>
        {' · '}
        <a href="/disclaimer">Disclaimer</a>
      </p>
    </div>
  </div>
</footer>
