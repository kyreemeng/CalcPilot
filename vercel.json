{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.calcpilot.net" }],
      "destination": "https://calcpilot.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "calcpilot-ten.vercel.app" }],
      "destination": "https://calcpilot.net/:path*",
      "permanent": true
    },
    {
      "source": "/finance/car-payment-calculator",
      "destination": "/finance/auto-loan-calculator",
      "permanent": true
    },
    {
      "source": "/finance/compound-interest-calculator",
      "destination": "/finance/compound-calculator",
      "permanent": true
    },
    {
      "source": "/finance/amortization-calculator",
      "destination": "/finance/mortgage-calculator",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(og-image.png|logo-icon.png|favicon.svg|llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(sitemap-index.xml|sitemap-0.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
